<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="CHI TIẾT CÔNG VIỆC"
        android:textColor="#0D47A1"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Tên công việc:"
        android:textColor="#616161"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvChiTietTen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#212121"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Mô tả công việc:"
        android:textColor="#616161"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvChiTietMoTa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="#FFFFFF"
        android:minHeight="70dp"
        android:padding="10dp"
        android:textColor="#424242"
        android:textSize="16sp" />

    <!-- Trạng thái -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Trạng thái:"
        android:textColor="#616161"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvChiTietTrangThai"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Chưa hoàn thành"
        android:textColor="#C62828"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Hiển thị số lần chỉnh sửa theo yêu cầu đề bổ sung -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Số lần chỉnh sửa:"
        android:textColor="#616161"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvSoLanChinhSua"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0 lần"
        android:textColor="#0D47A1"
        android:textSize="16sp"
        android:textStyle="bold" />

    <CheckBox
        android:id="@+id/cbHoanThanh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Đánh dấu đã hoàn thành"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnChinhSua"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#FB8C00"
        android:text="Chỉnh sửa công việc" />

    <Button
        android:id="@+id/btnQuayLai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#757575"
        android:text="Quay Lại" />

</LinearLayout>