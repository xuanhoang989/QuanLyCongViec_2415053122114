<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="CHỈNH SỬA CÔNG VIỆC"
        android:textColor="#E65100"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Tên công việc:"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtChinhSuaTen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập tên mới" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Mô tả công việc:"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtChinhSuaMoTa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top|start"
        android:hint="Nhập mô tả mới"
        android:lines="4" />

    <CheckBox
        android:id="@+id/cbChinhSuaHoanThanh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Đã hoàn thành công việc" />

    <Button
        android:id="@+id/btnLuuChinhSua"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="#2E7D32"
        android:text="Lưu thay đổi" />

    <Button
        android:id="@+id/btnHuyChinhSua"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#757575"
        android:text="Hủy" />

</LinearLayout>